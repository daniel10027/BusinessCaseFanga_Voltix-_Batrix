# Copier en .env pour un lancement local. Toutes les valeurs ci-dessous sont
# des valeurs de démonstration, jamais des secrets réels.

# --- Base de données ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fanga:fanga@localhost:5432/fanga_ingest

# --- Serveur TCP Voltix ----------------------------------------------------
VOLTIX_TCP_HOST=0.0.0.0
VOLTIX_TCP_PORT=9000
# Liste blanche des identifiants de cabinet acceptés, séparés par des virgules.
VOLTIX_ALLOWED_CABINET_IDS=VTX-CAB-0042
VOLTIX_READ_TIMEOUT_SECONDS=180
VOLTIX_MAX_INVALID_FRAMES=10

# --- Broker MQTT Batrix ------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=fanga-ingest-batrix
MQTT_TOPIC_FILTER=batrix/v1/+/telemetry

# --- API HTTP ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Supervision -------------------------------------------------------------
CABINET_OFFLINE_AFTER_SECONDS=180
CABINET_SWEEP_INTERVAL_SECONDS=30

# --- Intégration NestJS (outbox) --------------------------------------------
NESTJS_WEBHOOK_URL=http://localhost:3000/webhooks/fanga
OUTBOX_HMAC_SECRET=change-me-demo-secret
OUTBOX_RELAY_INTERVAL_SECONDS=5

# --- Inventaire (API métier Fanga) -------------------------------------------
INVENTORY_HMAC_SECRET=change-me-demo-secret

# --- Horloge (rejeu de démo) -------------------------------------------------
# Laisser vide en production : l'horloge système est alors utilisée.
REPLAY_START=2026-10-01T07:59:49Z
